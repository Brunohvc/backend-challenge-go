# Variáveis do serviço wallet, com os valores do ambiente Docker Compose.
# O compose não lê este arquivo nem um .env; ele serve de modelo para rodar o binário no host.
# A tabela das variáveis, com padrões e regras, está no README.md, na seção "Variáveis de ambiente".

# Instância
APP_INSTANCE_ID=app-1
LOG_LEVEL=info
SHUTDOWN_DRAIN_DELAY=2s
SHUTDOWN_TIMEOUT=60s

# API HTTP
HTTP_ENABLED=true
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_REQUEST_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=65536
HTTP_MAX_HEADER_BYTES=16384

# Servidor admin
ADMIN_ADDR=:9090

# PostgreSQL
DATABASE_URL=postgres://wallet_app:wallet_app@postgres:5432/wallet?sslmode=disable
DB_MAX_CONNS=20
DB_LOCK_TIMEOUT=2s
DB_STATEMENT_TIMEOUT=5s
DB_TX_MAX_ATTEMPTS=3
MIGRATIONS_DATABASE_URL=postgres://wallet_owner:wallet_owner@postgres:5432/wallet?sslmode=disable

# OIDC (Keycloak)
OIDC_ISSUER=http://localhost:8080/realms/wagering
OIDC_JWKS_URL=http://keycloak:8080/realms/wagering/protocol/openid-connect/certs
OIDC_AUDIENCE=wagering-api
OIDC_CLOCK_SKEW=30s

# AWS SDK
AWS_ENDPOINT_URL=http://ministack:4566
AWS_REGION=us-east-1
AWS_SHARED_CREDENTIALS_FILE=/run/aws/credentials
AWS_PROFILE=wallet-app

# Filas SQS
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_INPUT_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo

# Consumidor SQS
CONSUMER_ENABLED=true
CONSUMER_NAME=wager-transactions
CONSUMER_MAX_GROUPS=8
CONSUMER_VISIBILITY_TIMEOUT=30s
CONSUMER_PROCESSING_TIMEOUT=15s
CONSUMER_DRAIN_TIMEOUT=20s
CONSUMER_WAIT_TIME=20s
CONSUMER_MAX_RECEIVES=10

# Publicador da outbox
OUTBOX_RELAY_ENABLED=true
OUTBOX_POLL_INTERVAL=500ms
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE=30s
OUTBOX_BACKOFF_MAX=5m

# Resolvedor de referências pendentes
RESOLVER_ENABLED=true
RESOLVER_POLL_INTERVAL=1s
RESOLVER_BATCH_SIZE=50
RESOLVER_LEASE=30s
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_TTL=15m
REFERENCE_BACKOFF_BASE=1s
REFERENCE_BACKOFF_MAX=60s
PERMANENT_FAILURE_LIMIT=3

# Tracing (OpenTelemetry): vazio desliga; o overlay docker-compose.tracing.yml usa http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=wallet

# Testes e2e
# FAILPOINTS=submit.after_commit=exit
